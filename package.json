{
	"name": "penang-holidays",
	"version": "0.0.0",
	"private": true,
	"description": "Penang public holidays scraped from the Penang state government portal, as JSON and an API.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"gen": "wrangler types",
		"scrape": "node scripts/scrape.ts",
		"deploy": "pnpm build && wrangler deploy"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"node-html-parser": "^9.0.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.151.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
