{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "penang-holidays",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./data",
		"binding": "ASSETS",
		// Route every request through the Worker so the API has one consistent shape
		"run_worker_first": true
	}
}
