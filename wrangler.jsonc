{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "penang-holidays",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	// Serve the Worker at penang-holidays.<subdomain>.workers.dev
	"workers_dev": true,
	// Serve repeat requests from Cloudflare's cache without running the Worker, for as long as
	// the response's Cache-Control allows
	"cache": {
		"enabled": true
	},
	"assets": {
		"directory": "./data",
		"binding": "ASSETS",
		// Route every request through the Worker so the API has one consistent shape
		"run_worker_first": true
	}
}
