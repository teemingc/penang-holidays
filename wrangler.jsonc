{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "penang-holidays",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	// Serve the Worker at penang-holidays.<subdomain>.workers.dev
	"workers_dev": true,
	// Serve repeat requests from Cloudflare's cache without running the Worker, for as long as
	// the response's Cache-Control allows
	"cache": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
